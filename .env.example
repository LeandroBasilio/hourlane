# Copy to .env.local and configure locally. Never commit credentials.
# For Docker Compose, set POSTGRES_PASSWORD separately in .env.
DATABASE_URL=postgresql://hourlane:REPLACE_LOCAL_PASSWORD@127.0.0.1:54329/hourlane
TEST_DATABASE_URL=postgresql://hourlane:REPLACE_LOCAL_PASSWORD@127.0.0.1:54329/hourlane_test
# Optional separate database owner connection for migrations/operator tasks:
# MIGRATION_DATABASE_URL=
# OPERATOR_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LEAD_CAPTURE_ENABLED=false
SITE_LAUNCH_READY=false
PRIVACY_NOTICE_VERSION=2026-10-14-draft
# Enable only behind Vercel's documented trusted proxy, with VERCEL=1:
# TRUST_PROXY=vercel
# Optional E2E browser executable when Chromium is installed by the environment:
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
